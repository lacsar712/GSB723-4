# JVM runtime parameters for the backend service
# Consumed by docker/compose.override.dev.yml via env_file.
# All variables use SCREAMING_SNAKE_CASE.
# NOTE: Docker Compose env_file does NOT interpolate ${VAR} within this file,
# so JAVA_TOOL_OPTIONS must carry the concrete flag values below.

# Initial heap size (mirrored as a standalone variable for documentation/tuning)
BACKEND_HEAP_INIT=512m

# Maximum heap size (mirrored as a standalone variable for documentation/tuning)
BACKEND_HEAP_MAX=1024m

# Young generation size
BACKEND_HEAP_NEWSIZE=256m

# Garbage collector (G1 for balanced throughput/latency)
BACKEND_GC_TYPE=G1GC

# JVM tool options – picked up automatically by every JVM (works with exec-form ENTRYPOINT)
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m -Xmn256m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom

# Spring profile for docker runtime
SPRING_PROFILES_ACTIVE=docker

# Timezone
TZ=UTC
