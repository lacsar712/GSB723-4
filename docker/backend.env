# backend 运行时 JVM 参数（与编排定义分离，供 docker/compose.override.dev.yml 引用）
# 自定义变量名统一使用 SCREAMING_SNAKE_CASE。
# 说明：JAVA_TOOL_OPTIONS 会被 JVM 自动读取，无需改动 Dockerfile 的 ENTRYPOINT。
#       下方 BACKEND_HEAP_* / BACKEND_META_MAX 为参数来源（真实来源），
#       JAVA_TOOL_OPTIONS 中的取值与其保持一致，修改时请同步调整。

# 堆内存下限 / 上限
BACKEND_HEAP_MIN=256m
BACKEND_HEAP_MAX=512m
# Metaspace 上限
BACKEND_META_MAX=256m

# 实际下发给 JVM 的启动参数（值需与上面 BACKEND_* 保持一致）
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -Duser.timezone=UTC
