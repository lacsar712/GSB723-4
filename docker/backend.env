# ---------------------------------------------------------------------------
# backend.env
#
# 后端 JVM 运行时参数（开发态）。由 docker/compose.override.dev.yml 通过
# `env_file` 引用，禁止把下列参数硬编码到 compose YAML 中，以保持
# 「编排定义」与「运行时参数」分离。
#
# 自定义变量统一使用 SCREAMING_SNAKE_CASE。
# JAVA_TOOL_OPTIONS 为 JVM 官方环境变量，会被 JVM 在启动时自动读取，
# 因此无需修改 Dockerfile 的 ENTRYPOINT。
# ---------------------------------------------------------------------------

# 堆内存上下限
BACKEND_HEAP_MIN=256m
BACKEND_HEAP_MAX=1024m

# 元空间上限
BACKEND_METASPACE_MAX=256m

# GC 相关
BACKEND_GC_TYPE=-XX:+UseG1GC
BACKEND_GC_TUNE=-XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError

# 其它常用 JVM 参数
BACKEND_JVM_EXTRA_FLAGS=-Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8

# 真正传给 JVM 的选项（请在修改上面变量后同步更新此处）
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Dfile.encoding=UTF-8
